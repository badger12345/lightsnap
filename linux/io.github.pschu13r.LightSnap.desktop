[Desktop Entry]
Type=Application
Name=LightSnap
Comment=Screenshots and screen recordings, saved locally
Exec=lightsnap %f
Icon=io.github.pschu13r.LightSnap
Categories=Utility;Graphics;
Keywords=screenshot;screen;recording;capture;
MimeType=image/png;image/jpeg;video/mp4;
StartupWMClass=io.github.pschu13r.LightSnap
Terminal=false
